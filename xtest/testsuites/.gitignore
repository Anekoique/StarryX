# Vendored suites build IN their own source trees (the contest build system is
# upstream's). Keep the committed sources pristine by ignoring build outputs so
# a local `make tests` never leaks objects/binaries/configure cruft into git.

# Object files, libraries, dep files
*.o
*.obj
*.lo
*.la
*.a
*.d
*.Po
*.Plo
.deps/
.libs/
bld/

# Built test binaries / interpreters
*.exe
core

# autotools generated (configure-time)
config.status
config.log
config.cache
config.h
stamp-h*
libtool

# Per-suite built outputs (in-tree)
libctest/libc-test/disk/
lmbench/lmbench_src/bin/
lmbench/lmbench_src/libtirpc-1.3.6/
lua/lua/src/lua
lua/lua/src/luac
libcbench/libc-bench/libc-bench
cyclictest/rt-tests-2.7/cyclictest
cyclictest/rt-tests-2.7/hackbench
cyclictest/rt-tests-2.7/numactl-2.0.14/
unixbench/UnixBench/pgms/
iperf/iperf/src/iperf3
netperf/netperf-2.7.0/
iozone/src/*.o
